# What this repo checks, and when. Read by ~/.githooks/pre-commit.
#
# This is the template other repos get cloned from, so what it declares becomes
# the default everywhere. It replaces .pre-commit-config.yaml, which named ruff,
# mypy and biome and never ran once — the binary was never installed.
#
# Same three tools, declared the way every other repo declares, run by the one
# system instead of a fifth one.
commit='{ [ -z "$GR_STAGED_PY" ] || uv run --group dev ruff check $GR_STAGED_PY; } && { [ -z "$GR_STAGED_WEB" ] || npx --yes @biomejs/biome check $GR_STAGED_WEB; }'
# Scoped to what is actually being committed, not the whole tree: untracked
# work-in-progress is not part of this commit and must not block it.

commit_needs="uv npx"

push="uv run --group dev pytest -q && npm test"
push_needs="uv npm"

skip='\.(md|txt|png|jpg|jpeg|webp|gif|ico|svg)$|^docs/'
